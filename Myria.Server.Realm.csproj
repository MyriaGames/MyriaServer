<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>App.ico</ApplicationIcon>
    <!-- The project/solution file is Myria.Server.Realm, but the published binary keeps the
         historic "MyriaServer" name: run-production.sh/update-production.sh (shipped inside
         the release zip and run on the production box) hardcode ./MyriaServer. -->
    <AssemblyName>MyriaServer</AssemblyName>
    <Version>0.3.0.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
  </PropertyGroup>

  <!--
    gameStatus.json is live server state (GameDay/TimeOfDay/Ticks/LastSavedAt), written by
    GameStatusService at runtime — it must stay local to this project and must NOT be
    overwritten by a rebuild, unlike the shared game-content JSON below.
  -->
  <ItemGroup>
    <Content Remove="Data\common\gameStatus.json" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Data\common\gameStatus.json" />
  </ItemGroup>

  <!--
    Shared static game-content JSON and locale strings live once in Myria.Lib\Myria.Lib.Core\Data
    (see Myria.Lib.Core.csproj) and are linked in here rather than duplicated, matching
    Myria.Wpf.csproj/Myria.Console.csproj. This project used to keep its own hand-copied
    Data\common\*.json snapshot, which silently drifted out of sync with the canonical copy
    over time (missing Effects/AggroModifier fields, missing effects.json entirely, and a
    stale skills.json that granted "aimed_shot" instead of "venomous_shot" as an Archer's
    2nd skill) — linking instead of copying makes that class of drift structurally impossible.
  -->
  <ItemGroup>
    <Content Include="..\Myria.Lib\Myria.Lib.Core\Data\common\**\*.json" LinkBase="Data\common\">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\Myria.Lib\Myria.Lib.Core\Data\locales\**\*.json" LinkBase="Data\locales\">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Myria.Lib\Myria.Lib.Core\Myria.Lib.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Data\guild_config.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Update="Data\allowed_versions.json">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <None Include="run-production.sh">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <None Include="update-production.sh">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
    <!-- appsettings.Production.json holds real secrets on this dev machine (gitignored) —
         the Web SDK publishes appsettings.*.json to the output by default, which would ship
         it inside the release zip. Keep it usable for local `dotnet run`/`dotnet build`
         (CopyToOutputDirectory, untouched) but exclude it specifically from `dotnet publish`
         output. Real production config must come from environment variables at deploy time. -->
    <Content Update="appsettings.Production.json">
      <CopyToPublishDirectory>Never</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
